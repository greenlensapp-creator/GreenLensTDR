# GROQ_API_KEY: Clave de autenticación de Groq API (formato gsk_...)
# Configúrala en el panel de Netlify -> Site configuration -> Environment variables
GROQ_API_KEY=

# VITE_API_BASE_URL: (Opcional) URL del backend de GreenLens en producción (ej. / o https://mi-sitio.netlify.app)
VITE_API_BASE_URL=/

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
