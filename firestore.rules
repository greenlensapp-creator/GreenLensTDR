rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para perfiles de usuario
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reglas para el historial privado de escaneos de cada usuario
    match /users/{userId}/scans/{scanId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para configuración personal del usuario
    match /users/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Directorio de correos registrados (para verificación amigable de credenciales sin filtrar datos privados)
    match /registered_emails/{emailDoc} {
      allow read: if true;
      allow write: if true;
    }

    // Configuración global de la aplicación (URL centralizada del modelo Teachable Machine)
    match /app_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Caché compartido de especies consultadas a Groq (para ahorrar llamadas)
    match /species_info/{speciesId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
